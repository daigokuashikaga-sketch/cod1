# Reasoning + vision. Required for anything beyond the offline echo backend.
ANTHROPIC_API_KEY=

# Optional premium TTS. Leave empty to use the local Kokoro backend (free).
ELEVENLABS_API_KEY=

# Overrides for config.toml (env always wins). See docs/CONFIG.md.
JARVIS_AGENT__MODEL=claude-sonnet-5
JARVIS_VISION__MODEL=claude-haiku-4-5-20251001
JARVIS_VISION__ENABLED=false
JARVIS_VOICE__STT_BACKEND=null
JARVIS_VOICE__TTS_BACKEND=null
